# Mẫu cấu hình cho backend. Chép thành .env ở CÙNG thư mục này (thư mục gốc repo)
# rồi điền giá trị thật — .env nằm trong .gitignore, còn file mẫu này thì được commit.
#
# Chỉ liệt kê những biến thường phải khai lại; toàn bộ danh sách biến và giá trị mặc định nằm
# trong common/core/config.py. Thứ tự các nhóm xếp theo sức ảnh hưởng giảm dần: sai nhóm
# đầu thì backend không khởi động được, sai nhóm cuối chỉ đổi hành vi một tính năng.
# Sửa file này xong phải restart backend — pydantic-settings chỉ đọc .env một lần lúc import.


# =============================================================================
# 1. CƠ SỞ DỮ LIỆU HỆ THỐNG (Postgres bên ngoài, có pgvector)
#    Không có nhóm này thì không có gì chạy được: metadata, hội thoại, quyền đều nằm ở đây.
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=root
# Ghi mật khẩu THÔ, không URL-encode sẵn: config.py dựng chuỗi kết nối bằng
# urllib.parse.quote(DB_PASSWORD), nên '@' sẽ tự thành %40. Điền sẵn '%40' ở đây là mã hóa
# hai lần ('%' -> '%25'), psycopg giải ra 'Password123%40pg' và Postgres từ chối đăng nhập.
DB_PASSWORD=Password123@pg
DB_NAME=sqlbot


# =============================================================================
# 2. BÍ MẬT KÝ TOKEN
#    Không khai thì code tự sinh khoá ngẫu nhiên mỗi lần khởi động, nên mọi phiên đăng nhập chết
#    theo mỗi lần restart backend. Trong Kubernetes biến này lấy từ Secret, cùng một giá trị cho mọi replica.
# =============================================================================
# Sinh bằng: openssl rand -base64 32
SECRET_KEY=

# Mật khẩu mặc định của người dùng mới và khi đặt lại mật khẩu (mặc định trong code là SQLBot@123456).
# Tài khoản admin do migration 001 tạo với mật khẩu cố định SQLBot@123456, biến này KHÔNG đổi mật khẩu admin
# đã có; muốn đổi thì đăng nhập admin và đổi mật khẩu. ai-gateway đăng nhập tài khoản workspace bằng đúng giá trị
# này (SQLBOT_DEFAULT_PASSWORD bên ai-gateway phải giống).
# DEFAULT_PWD=


# =============================================================================
# 3. ĐƯỜNG DẪN DỮ LIỆU TRÊN ĐĨA
#    Sai nhóm này là hỏng NGAY LÚC IMPORT, trước cả khi web server kịp lắng nghe cổng.
# =============================================================================
# Mặc định trong code là /opt/sqlbot/... và Dockerfile đã tạo sẵn các thư mục đó cho appuser,
# nên chạy trong container thì bỏ trống cả nhóm này. Chạy local thì user thường không ghi được
# vào /opt, phải đổi:
#   UPLOAD_DIR     sqlbot_xpack mkdir thư mục này ngay lúc import, không ghi được là PermissionError.
#   EXCEL_PATH     file tạm của createFromExcelAsync và các endpoint upload/xuất Excel khác.
#                  createFromExcel đồng bộ đọc file trong RAM, không ghi gì vào đây.
#   MCP_IMAGE_PATH main.py tạo thư mục này lúc khởi động để mount /images.


# =============================================================================
# 4. EMBEDDING
#    Backend vẫn lên được khi sai, nhưng mọi thao tác lưu/đồng bộ datasource sẽ ném lỗi.
# =============================================================================
# Mặc định trong code đã là 'api': gọi một server embedding tương thích OpenAI.
# Đây là cấu hình dự phòng; workspace hoặc datasource có cấu hình model do Gateway đẩy xuống
# (/ai-model-config) thì dùng cấu hình đó.


# =============================================================================
# 5. CACHE
#    Mặc định trong code là 'memory' (chạy được một mình). Trỏ sang redis thì redis phải sống,
#    vì đây là nơi giữ thông tin đăng nhập và API key.
# =============================================================================
CACHE_TYPE=redis
REDIS_CONNECTION_STRING=localhost:6379
#    REDIS_CONNECTION_STRING là danh sách host:port cách nhau bằng dấu phẩy, ý nghĩa theo REDIS_MODE:
#      standalone (mặc định): một Redis duy nhất
#      sentinel             : các Sentinel, cộng REDIS_SENTINEL_MASTER là tên master Sentinel theo dõi
#      cluster              : vài node của cluster, client tự dò ra phần còn lại
#    Mật khẩu bỏ trống hoặc xóa dòng là không dùng mật khẩu.
# REDIS_MODE=standalone
# REDIS_SENTINEL_MASTER=mymaster
# REDIS_PASSWORD=
# REDIS_SENTINEL_PASSWORD=
# REDIS_DATABASE_ID=0


# =============================================================================
# 6. TẢI FILE TỪ URL
#    POST /datasource/createFromExcel nhận presigned URL của object storage: thiếu host ở đây
#    thì mọi lần tạo datasource Excel đều bị từ chối với URL_HOST_NOT_ALLOWED.
# =============================================================================
# Danh sách host được phép tải file về, ngăn cách bằng dấu phẩy. Áp dụng cho nạp Excel từ URL và
# file .docx đính kèm câu hỏi chat. RỖNG LÀ CẤM TẤT CẢ — đây là lớp chống SSRF, nên nó cố tình
# hỏng theo hướng đóng.
FILE_DOWNLOAD_ALLOWED_HOSTS=
# Trần dung lượng file Excel tải từ URL (MB). Bản đồng bộ giữ cả file trong RAM. H04 đặt 25.
EXCEL_DOWNLOAD_MAX_MB=100


# =============================================================================
# 7. LLM
# =============================================================================
# Tắt pha thinking của LLM. Model reasoning (Qwen3…) có thể kẹt trong vòng lặp suy luận, đốt hết
# ngân sách token mà không xuất ra content nào — pipeline nhận chuỗi rỗng rồi chết. Tắt thinking
# khiến model trả thẳng đáp án, nhanh và ổn định hơn nhiều cho tác vụ sinh SQL.
# Đặt False nếu muốn bật lại thinking cho model hỗ trợ tốt.
LLM_DISABLE_THINKING=True
