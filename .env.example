# Mẫu cấu hình cho backend. Chép thành .env ở CÙNG thư mục này (thư mục gốc repo, không phải
# backend/) rồi điền giá trị thật — .env nằm trong .gitignore, còn file mẫu này thì được commit.
#
# Chỉ liệt kê những biến thường phải khai lại; toàn bộ danh sách biến và giá trị mặc định nằm
# trong backend/common/core/config.py. Thứ tự các nhóm xếp theo sức ảnh hưởng giảm dần: sai nhóm
# đầu thì backend không khởi động được, sai nhóm cuối chỉ đổi hành vi một tính năng.
# Sửa file này xong phải restart backend — pydantic-settings chỉ đọc .env một lần lúc import.


# =============================================================================
# 1. CƠ SỞ DỮ LIỆU HỆ THỐNG (khớp docker-compose.service.yml)
#    Không có nhóm này thì không có gì chạy được: metadata, hội thoại, quyền đều nằm ở đây.
# =============================================================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=root
# Ghi mật khẩu THÔ, không URL-encode sẵn: config.py dựng chuỗi kết nối bằng
# urllib.parse.quote(POSTGRES_PASSWORD), nên '@' sẽ tự thành %40. Điền sẵn '%40' ở đây là mã hóa
# hai lần ('%' -> '%25'), psycopg giải ra 'Password123%40pg' và Postgres từ chối đăng nhập.
POSTGRES_PASSWORD=Password123@pg
POSTGRES_DB=sqlbot


# =============================================================================
# 2. ĐƯỜNG DẪN DỮ LIỆU TRÊN ĐĨA
#    Sai nhóm này là hỏng NGAY LÚC IMPORT, trước cả khi web server kịp lắng nghe cổng.
# =============================================================================
# Mặc định trong code là /opt/sqlbot/... (dành cho container chạy bằng root).
# Chạy local thì user thường không ghi được vào /opt, và sqlbot_xpack mkdir
# UPLOAD_DIR ngay lúc import nên sẽ lỗi PermissionError nếu không đổi.
# Chạy trong Docker thì bỏ trống cả nhóm này, dùng mặc định của code.
BASE_DIR=/duong/dan/tuyet/doi/toi/thu/muc/du/lieu
UPLOAD_DIR=/duong/dan/tuyet/doi/toi/thu/muc/du/lieu/data/file
EXCEL_PATH=/duong/dan/tuyet/doi/toi/thu/muc/du/lieu/data/excel
MCP_IMAGE_PATH=/duong/dan/tuyet/doi/toi/thu/muc/du/lieu/images
LOCAL_MODEL_PATH=/duong/dan/tuyet/doi/toi/thu/muc/du/lieu/models


# =============================================================================
# 3. EMBEDDING
#    Backend vẫn lên được khi sai, nhưng mọi thao tác lưu/đồng bộ datasource sẽ ném lỗi.
# =============================================================================
# Mặc định trong code là 'local': nạp shibing624_text2vec-base-chinese từ LOCAL_MODEL_PATH.
# Model đó chỉ có sẵn trong image Docker (Dockerfile copy từ maxkb-vector-model), chạy local
# không có nên get_model() ném FileNotFoundError mỗi lần lưu/sync datasource.
# Đặt 'api' và trỏ sang một server tương thích OpenAI để khỏi phải tải model về đĩa;
# hai biến EMBEDDING_API_* chỉ có tác dụng khi provider là 'api'.
EMBEDDING_PROVIDER=api
EMBEDDING_API_BASE_URL=http://embedding-server:1999/v1
EMBEDDING_API_MODEL=BAAI/bge-m3


# =============================================================================
# 4. CACHE
#    Mặc định trong code là 'memory' (chạy được một mình). Trỏ sang redis thì redis phải sống,
#    vì đây là nơi giữ thông tin đăng nhập và API key.
# =============================================================================
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://localhost:6379/0


# =============================================================================
# 5. CORS — ORIGIN NÀO ĐƯỢC GỌI VÀO BACKEND TỪ TRÌNH DUYỆT
#    Sai nhóm này thì API vẫn chạy đúng nhưng trình duyệt chặn, biểu hiện giống hệt server chết.
# =============================================================================
# Frontend dev server.
FRONTEND_HOST=http://localhost:5173

# all_cors_origins = BACKEND_CORS_ORIGINS + [FRONTEND_HOST]. Starlette so khớp chuỗi chính xác:
# khác scheme/host/port là bị chặn, không có wildcard theo domain. Ngăn cách bằng dấu phẩy.
# Thêm origin production của đối tác vào đây khi họ deploy.
CORS_ALLOW_ALL_ORIGINS=False
BACKEND_CORS_ORIGINS=http://localhost:3000


# =============================================================================
# 6. TÍCH HỢP VỚI HỆ SOFTWARE — TẢI FILE VỀ VÀ BÁO KẾT QUẢ
#    Một bên là nơi được phép TẢI file về, một bên là nơi BÁO kết quả nạp xong.
#    Allowlist chi phối cả POST /datasource/createFromExcelAsync lẫn `fileUrl` của
#    POST /chat/question, nên tên biến không mang tiền tố của riêng luồng nào.
# =============================================================================
# Danh sách host được phép tải file về, ngăn cách bằng dấu phẩy. Chi phối CẢ HAI luồng: nạp excel
# bất đồng bộ và file .docx đính kèm câu hỏi chat. RỖNG LÀ CẤM TẤT CẢ —
# đây là lớp chống SSRF, nên nó cố tình hỏng theo hướng đóng.
FILE_DOWNLOAD_ALLOWED_HOSTS=

# Để trống = TẮT HẲN việc gửi: job vẫn nạp dữ liệu bình thường, thư kết quả nằm chờ trong bảng
# excel_import_jobs và không đốt lần thử nào. Điền URL gateway của SW rồi restart backend là các
# thư đang chờ tự động đi. Cổng nhận hiện không đòi xác thực nên không cần AI_CALLBACK_AUTH_HEADER.
AI_CALLBACK_URL=


# =============================================================================
# 7. HÀNH VI PIPELINE CHAT
#    Chỉ đổi hình dạng một lượt hỏi, không ảnh hưởng phần còn lại của hệ thống.
# =============================================================================
# Pha sinh biểu đồ của POST /chat/question. Mặc định True (bật). Bật thì mỗi câu hỏi tốn thêm MỘT
# lượt gọi LLM (2 -> 3), stream có thêm nhóm event chart-result/chart, và pha biểu đồ hỏng sẽ giết
# cả lượt hỏi (client nhận `error` thay cho `answer` + `finish`). Đặt False để quay về hành vi cũ:
# dừng ngay sau câu trả lời bằng lời.
GENERATE_CHART_ENABLED=True

# Cổng định tuyến câu hỏi: một lượt gọi LLM NGẮN trước pha SQL, quyết định lượt này có cần truy vấn
# dữ liệu mới hay không. TẮT (mặc định) thì đường đi giống hệt trước khi có cổng — không thêm lời
# gọi LLM, không thêm event SSE, không thêm bản ghi chat_log.
# Vấn đề nó giải: pha SQL vẫn chạy kể cả với câu chào hỏi, câu tham chiếu ngược ("trong đó cái nào
# lớn nhất") hay câu hỏi về chính datasource. Đó là pha đắt nhất và cũng là pha bơm cả m-schema vào
# ngữ cảnh, nên chạy thừa vừa tốn tiền vừa làm nhiễu câu trả lời.
# Chỉ áp dụng cho nhánh in_chat. Nhánh MCP luôn đi pha SQL bất kể biến này.
LLM_ROUTE_ENABLED=False
# Chế độ CHỈ ĐO. Cổng vẫn chạy và vẫn ghi chat_log, nhưng quyết định bị ép về "sql" nên hành vi
# người dùng nhìn thấy KHÔNG đổi — dấu forced='shadow' trong log đánh dấu đúng những lượt cổng muốn
# bỏ SQL mà bị chặn, đếm nhóm đó ra tỷ lệ tiết kiệm được. Đọc số bằng
# `scripts/route_stats/report.py --days 7`.
# Mặc định True là cố ý: bật LLM_ROUTE_ENABLED lần đầu thì vào thẳng chế độ đo, không có đường nào
# vô tình nhảy sang đổi hành vi thật. Đặt False chỉ sau khi đã đọc số đo và chấp nhận nó.
LLM_ROUTE_SHADOW=True
# Model riêng cho cổng, trỏ tới id trong bảng ai_model_detail. 0 = dùng chung model chính.
# Cổng chỉ phân loại một câu hỏi ngắn nên model nhỏ là đủ, mà rẻ và nhanh hơn hẳn. Lưu ý prompt
# được tinh chỉnh theo model: đổi model ở đây thì phải đo lại độ chính xác của cổng.
LLM_ROUTE_MODEL_ID=0
# Số lượt hỏi-đáp cũ đưa vào prompt cổng. Cổng chỉ cần biết lượt trước đã lấy về những gì để nhận
# ra câu tham chiếu ngược, nên ngân sách nhỏ hơn hẳn nhánh answer.
LLM_ROUTE_HISTORY_ROUNDS=2
LLM_ROUTE_HISTORY_ROWS=5

# Gợi ý câu hỏi tiếp theo ngay trong POST /chat/question.
# Khác endpoint rời ở hai chỗ, và đó là lý do tồn tại của nó: câu hỏi cũ đưa vào prompt chỉ lấy
# của CHÍNH user đang hỏi (endpoint rời lấy 20 câu gần nhất của mọi user chung datasource), và
# kết quả chỉ ghi vào `chat_record` chứ không bao giờ ghi đè gợi ý cấp hội thoại.
CHAT_INLINE_RECOMMEND_ENABLED=True
# Số câu gợi ý tối đa. Đây là trần đưa vào prompt, LLM có thể trả ít hơn.
CHAT_INLINE_RECOMMEND_COUNT=2
# Số câu hỏi cũ CỦA CHÍNH user đưa vào prompt gợi ý. Chỉ dùng để LLM đoán thói quen hỏi, nhiều
# hơn không tốt hơn mà chỉ tốn token.
CHAT_INLINE_RECOMMEND_HISTORY=20
